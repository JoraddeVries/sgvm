#calculate efficiency
score = dt[dt$evaluation%in%c("Point"),] %>%
mutate(
n.x = ifelse(is.na(n.x),0,n.x),
n.y = ifelse(is.na(n.y),0,n.y),
total_skill.x = ifelse(is.na(total_skill.x),0,total_skill.x),
total_skill.y = ifelse(is.na(total_skill.y),0,total_skill.y),
)
error = dt[dt$evaluation%in%c("Error"),] %>%
mutate(
n.x = ifelse(is.na(n.x),0,n.x),
n.y = ifelse(is.na(n.y),0,n.y),
total_skill.x = ifelse(is.na(total_skill.x),0,total_skill.x),
total_skill.y = ifelse(is.na(total_skill.y),0,total_skill.y),
)
eff = merge(score,error,by=c("match_id","set_number","home_team","skill","final_score_home","final_score_away","delta_score"),all=T)
eff$eff.x = (eff$n.x.x-eff$n.x.y)/eff$total_skill.x.x
eff$eff.y = (eff$n.y.x-eff$n.y.y)/eff$total_skill.y.x
eff$delta_eff = eff$eff.x-eff$eff.y
p13r  = ggplot(eff[eff$skill=="Attack"&eff$phase.x=="Reception",], aes(x=delta_eff, y=delta_score))+
geom_point(size=1) +
geom_smooth(method=lm, se=F) +
stat_cor(p.accuracy = 0.001, r.accuracy = 0.01, aes(label = paste(..rr.label.., ..p.label.., sep = "~`,`~")))+
xlab("Delta side-out attack eff% (home-away)") +
ylab("Delta final score (home-away)") +
ggtitle("Attack") +
theme_cowplot()+
theme(panel.background = element_rect(fill = NA, color = "black"))+
theme(
text = element_text(size = 10),   # Reduce all text sizes
axis.text = element_text(size = 10),   # Adjust axis text
axis.title = element_text(size = 10),  # Adjust axis titles
plot.title = element_text(size = 10)   # Adjust plot title
)
p13t  = ggplot(eff[eff$skill=="Attack"&eff$phase.x=="Transition",], aes(x=delta_eff, y=delta_score))+
geom_point(size=1) +
geom_smooth(method=lm, se=F) +
stat_cor(p.accuracy = 0.001, r.accuracy = 0.01, aes(label = paste(..rr.label.., ..p.label.., sep = "~`,`~")))+
xlab("Delta rally attack eff% (home-away)") +
ylab("Delta final score (home-away)") +
ggtitle("Attack") +
theme_cowplot()+
theme(panel.background = element_rect(fill = NA, color = "black"))+
theme(
text = element_text(size = 10),   # Reduce all text sizes
axis.text = element_text(size = 10),   # Adjust axis text
axis.title = element_text(size = 10),  # Adjust axis titles
plot.title = element_text(size = 10)   # Adjust plot title
)
#wat willen we weten
#Welk facet van het spel is bepalend voor het winnen van een set?
#Is dit anders als de teams aan elkaar gewaagd zijn? (i.e. setstand is binnen 5 punten)
#Zijn er verschillende speelstijlen te identificeren? (i.e. analyse per team maken)
#hoe belangrijk is het aanvals% van de verschillende aanvallers, en hoezeer is dat gecorreleerd met het aantal ballen wat de middens krijgen
setwd(paste0("C:/Users/vries473/Thuis/Volleybal/Datavolley/Output/",folder))
# Add the grid table (e.g., attack table) as the first page
# Create the table grob
table_grob <- tableGrob(attack, rows = NULL, theme = ttheme_minimal())
# Save the table grob as an image (PNG)
png_filename <- "temp table.png"
png(png_filename, width = 3, height = 2, units = "in", res = 300)
grid.text(team, x = 0.5, y = 0.95, gp = gpar(fontsize = 16, fontface = "bold"))
grid.draw(table_grob)  # Draw the table onto the PNG file
dev.off()
table_image <- png::readPNG(png_filename)
table_grob_image <- rasterGrob(table_image, width = unit(1, "npc"), height = unit(1, "npc"))
# List of all the plots
plots <- list(table_grob_image, p1, p1a, p1b, p1c, p1d, p2r, p3r, p4r, p5r, p6r,
p13r, p2t, p3t, p4t, p5t, p6t, p13t, p7, p8,
p9, p10, p11, p12)
# Number of plots per page
plots_per_page <- 6
# Save to PDF with 6 plots per page (table included)
pdf(paste0(team, ".pdf"), paper = "a4", height = 11, width = 8.5)
for (i in seq(1, length(plots), by = 6)) {
grid.arrange(
grobs = plots[i:min(i+5, length(plots))], # Select 6 items per page
ncol = 2, # 2 columns
nrow = 3  # 3 rows
)
}
# Close the PDF device
dev.off()
}
